      "doGet": "public",
      "api_getAvailability": "public",
      "api_submitReservation": "public",
      "api_getRequestStatus": "public",
      "api_admin_register": "admin",
      "api_admin_list": "admin",
      "api_admin_cancel": "admin",
      "api_admin_callList": "admin",
      "job_processNotifications": "job",
      "setup_init": "operator"
